NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (project: lucrescente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test keys until the client provides live keys)
# No publishable key is listed: the shop uses Stripe's hosted payment page, so
# the browser never talks to Stripe directly and has nothing to authenticate
# with. Add NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY back only if the checkout ever
# moves to embedded Checkout or Elements, which do run in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dev only: when STRIPE_SECRET_KEY is empty and this is true, /api/checkout uses a local mock checkout page.
CHECKOUT_MOCK=false

# Contact form (/api/contact). Without both of these the form shows an honest error
# and points people at CONTACT_EMAIL instead of pretending the message was sent.
# RESEND_API_KEY: from resend.com -> API Keys.
RESEND_API_KEY=
# CONTACT_EMAIL: the inbox that receives the messages.
CONTACT_EMAIL=
# CONTACT_FROM_EMAIL: optional. Defaults to Resend's shared sender, which only delivers
# to the address that owns the Resend account. Once the lucrescente domain is verified
# in Resend, set this to e.g. "lucrescente <ola@lucrescente.pt>".
CONTACT_FROM_EMAIL=
